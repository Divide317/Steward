# Optional. A free Gemini API key from Google AI Studio (https://aistudio.google.com/apikey),
# shared by every player who picks "Free AI" without their own key.
# Leave billing off on that Google project and it cannot be charged.
GEMINI_API_KEY=

# Optional: the Gemini model that judges. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: typed replies each visitor may send through the shared key per 10 minutes. Defaults to 30.
# STEWARD_RATE_LIMIT=30
